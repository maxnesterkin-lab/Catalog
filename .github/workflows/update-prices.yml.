name: Update Saby Retail Data

on:
  schedule:
    - cron: '0 */2 * * *' # Запускать каждые 2 часа (можно изменить)
  workflow_dispatch:      # Кнопка ручного запуска прямо на сайте GitHub

jobs:
  update-data:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Run script to fetch data from Saby
        env:
          SABY_TOKEN: ${{ secrets.SABY_TOKEN }}
        run: |
          node update-script.js

      - name: Commit and push if data changed
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "Auto-update prices and stock from Saby API"
          file_pattern: data.json

